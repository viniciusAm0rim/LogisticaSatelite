@page "/"
@page "/login"
@inject SessaoStateService Sessao
@inject NavigationManager Navigation

<PageTitle>Acesso — Logística Satélite</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-aside">
            <div class="aside-top">
                <span class="aside-badge">SISTEMA DE GESTÃO LOGÍSTICA</span>
                <h2 class="aside-title">Logística Satélite</h2>
                <p class="aside-description">
                    Controle integrado de pedidos, acompanhamento comercial e indicadores operacionais de separação, conferência e expedição.
                </p>
            </div>

            <div class="aside-footer">
                <div class="aside-divider"></div>
                <span class="aside-meta">Acesso restrito a colaboradores autorizados</span>
            </div>
        </div>

        <div class="login-form-panel">
            <div class="login-form-header">
                <h1>Entrar no sistema</h1>
                <p>Informe seu usuário e senha corporativos para continuar.</p>
            </div>

            <EditForm Model="form" OnValidSubmit="RealizarLogin" FormName="LoginForm">
                <div class="mb-3">
                    <label class="form-label" for="inputUsuario">Usuário</label>
                    <div class="input-with-icon">
                        <i class="bi bi-person input-icon"></i>
                        <input id="inputUsuario"
                               type="text"
                               class="form-control ps-5"
                               @bind="form.Usuario"
                               placeholder="Digite seu usuário"
                               autocomplete="username" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="inputSenha">Senha</label>
                    <div class="input-with-icon">
                        <i class="bi bi-lock input-icon"></i>
                        <input id="inputSenha"
                               type="@(mostrarSenha ? "text" : "password")"
                               class="form-control ps-5 pe-5"
                               @bind="form.Senha"
                               placeholder="Digite sua senha"
                               autocomplete="current-password" />
                        <button type="button"
                                class="btn-toggle-pass"
                                tabindex="-1"
                                @onclick="AlternarVisibilidadeSenha"
                                title="@(mostrarSenha ? "Ocultar senha" : "Mostrar senha")">
                            <i class="bi @(mostrarSenha ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>@mensagemErro</span>
                    </div>
                }

                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    Acessar painel
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginInput form = new();
    private string? mensagemErro;
    private bool mostrarSenha;

    protected override void OnInitialized()
    {
        if (Sessao.Autenticado)
        {
            RedirecionarPorPerfil();
        }
    }

    private void AlternarVisibilidadeSenha()
    {
        mostrarSenha = !mostrarSenha;
    }

    private void RealizarLogin()
    {
        mensagemErro = null;

        if (!Sessao.TentarAutenticar(form.Usuario, form.Senha))
        {
            mensagemErro = "Usuário ou senha inválidos.";
            return;
        }

        RedirecionarPorPerfil();
    }

    private void RedirecionarPorPerfil()
    {
        if (Sessao.Perfil == PerfilAcesso.Comercial)
            Navigation.NavigateTo("/comercial");
        else if (Sessao.Perfil == PerfilAcesso.Adm)
            Navigation.NavigateTo("/adm");
    }

    private sealed class LoginInput
    {
        public string Usuario { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}