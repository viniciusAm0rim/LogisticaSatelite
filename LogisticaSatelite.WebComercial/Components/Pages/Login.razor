@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; background-color: #f8fafc;">
    <div class="card p-4 shadow-sm border-0" style="width: 380px; border-radius: 12px;">
        <h4 class="text-center mb-1 text-primary fw-bold">Portal Comercial</h4>
        <p class="text-center text-muted small mb-4">Logística Satélite</p>

        <div class="mb-3">
            <label class="form-label text-secondary fw-semibold">Usuário</label>
            <input type="text" class="form-control" @bind="Usuario" placeholder="Digite seu usuário..." />
        </div>

        <div class="mb-4">
            <label class="form-label text-secondary fw-semibold">Senha</label>
            <input type="password" class="form-control" @bind="Senha" placeholder="Digite sua senha..." />
        </div>

        @if (!string.IsNullOrEmpty(MensagemErro))
        {
            <div class="alert alert-danger p-2 text-center text-sm mb-3">@MensagemErro</div>
        }

        <button class="btn btn-primary w-100 fw-bold py-2" @onclick="FazerLogin">ENTRAR</button>

        <div class="mt-3 text-center">
            <span class="badge bg-light text-secondary border">
                Demo: <strong>Vinicius</strong> / <strong>123</strong>
            </span>
        </div>
    </div>
</div>

@code {
    private string Usuario { get; set; } = "";
    private string Senha { get; set; } = "";
    private string MensagemErro { get; set; } = "";

    private void FazerLogin()
    {
        string u = Usuario.Trim().ToLower();
        string s = Senha.Trim();

        if (u == "comercial" && s == "123")
        {
            NavManager.NavigateTo("/comercial");
        }
        else if (u == "vinicius" && s == "123")
        {
            NavManager.NavigateTo("/comercial-mock");
        }
        else
        {
            MensagemErro = "Credenciais inválidas! Utilize comercial/123 ou Vinicius/123";
        }
    }
}