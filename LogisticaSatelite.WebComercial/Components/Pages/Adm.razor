@page "/adm"
@page "/adm-mock"
@using System.Globalization
@using System.Text
@using LogisticaSatelite.WebComercial.Models
@using LogisticaSatelite.WebComercial.Services.Interfaces
@inject IAdmService AdmService
@inject IDevolucoesService DevolucoesService
@inject SessaoStateService Sessao
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Administração — Logística Satélite</PageTitle>

<div class="container-xl py-4">
    <header class="topbar-card">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="page-title mb-0">Painel Administrativo</h1>
                @if (Sessao.UsarMock)
                {
                    <span class="badge bg-warning text-dark">MODO MOCK</span>
                }
            </div>
            <p class="page-subtitle mb-0">Indicadores operacionais, acurácia de conferência e desempenho por operador</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-primary btn-sm position-relative" @onclick="AbrirGavetaDevolucoesAsync">
                <i class="bi bi-arrow-return-left me-1"></i>
                Devoluções
                @if (qtdDevolucoesPendentes > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @qtdDevolucoesPendentes
                    </span>
                }
            </button>

            <button type="button" class="btn btn-outline-success btn-sm" @onclick="BaixarPlanilhaAvariadosAsync" disabled="@exportandoAvariados">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                @(exportandoAvariados ? "Gerando CSV..." : "Planilha Avariados (CSV)")
            </button>

            <a href="@LinkExternoDevolucao" target="_blank" class="btn btn-outline-secondary btn-sm" title="Abrir formulário público do cliente">
                <i class="bi bi-box-arrow-up-right me-1"></i>Link Cliente
            </a>

            <span class="user-label ms-2">Usuário: <strong>@Sessao.NomeUsuario</strong></span>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Sair">
                Sair
            </button>
        </div>
    </header>

    @if (carregando)
    {
        <div class="panel-card state-box">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            <span>Carregando indicadores administrativos...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(erroConexao))
    {
        <div class="panel-card state-box state-error">
            <p class="fw-semibold mb-1">Erro de conexão</p>
            <p class="small mb-3">@erroConexao</p>
            <button type="button" class="btn btn-primary-custom btn-sm" @onclick="() => CarregarDashboardAsync(funcionarioSelecionado)">
                Tentar novamente
            </button>
        </div>
    }
    else if (dados == null || dados.PedidosRecebidos == 0)
    {
        <div class="panel-card state-box">
            <p class="fw-semibold mb-1">Sem dados operacionais</p>
            <p class="text-muted small mb-0">Não existem registros de pedidos para o escopo selecionado.</p>
        </div>
    }
    else
    {
        <!-- Card Seletor de Escopo (Todos ou Funcionário Específico) -->
        <section class="panel-card mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-7">
                    <h2 class="section-heading mb-1">Escopo de Análise</h2>
                    <p class="text-muted small mb-0">
                        Selecione um operador para filtrar todos os indicadores e gráficos ou visualize a operação completa.
                    </p>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="selectFuncionario">Operador / Escopo</label>
                    <select id="selectFuncionario"
                            class="form-select"
                            value="@funcionarioSelecionado"
                            @onchange="AoAlterarFuncionario">
                        <option value="Todos">Todos os funcionários</option>
                        @foreach (var func in dados.FuncionariosDisponiveis)
                        {
                            <option value="@func">@func</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <!-- 6 Cards de Indicadores -->
        <section class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Pedidos Recebidos</span>
                    <div class="kpi-value tabular-nums">@dados.PedidosRecebidos</div>
                    <span class="kpi-meta">Escopo: @dados.EscopoSelecionado</span>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Pedidos Enviados</span>
                    <div class="kpi-value tabular-nums">@dados.PedidosEnviados</div>
                    <span class="kpi-meta">
                        @(dados.PedidosRecebidos > 0
                            ? $"{Math.Round((double)dados.PedidosEnviados / dados.PedidosRecebidos * 100, 1):N1}% concluídos"
                            : "0% concluídos")
                    </span>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Tempo Médio por Pedido</span>
                    <div class="kpi-value tabular-nums">@FormatarMinutos(dados.TempoMedioPorPedidoMin)</div>
                    <span class="kpi-meta">Tempo líquido ativo (sem pausas)</span>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Erros Evitados</span>
                    <div class="kpi-value tabular-nums">@dados.ErrosEvitados</div>
                    <span class="kpi-meta">Bloqueios preventivos na bipagem</span>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Acurácia de Tempo (Conferência)</span>
                    <div class="kpi-value tabular-nums">@($"{dados.AcuraciaConferenciaPercentual:N1}%")</div>
                    <span class="kpi-meta">@dados.ConferenciasNoPrazo de @dados.ConferenciasTotais conferências no prazo</span>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="kpi-card">
                    <span class="kpi-label">Pausas e Tempo Total Pausado</span>
                    <div class="kpi-value tabular-nums">@dados.QuantidadePausas <small class="fs-6 fw-normal text-muted">pausas</small></div>
                    <span class="kpi-meta">Tempo acumulado: @FormatarMinutos(dados.TempoTotalPausadoMin)</span>
                </div>
            </div>
        </section>

        <!-- Gráficos -->
        <section class="row g-4">
            <!-- Gráfico 1: Barras - Etapas finalizadas por funcionário -->
            <div class="col-lg-12">
                <div class="panel-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h2 class="section-heading mb-1">Etapas Finalizadas por Funcionário</h2>
                            <p class="text-muted small mb-0">Distribuição de separações, conferências e expedições concluídas</p>
                        </div>
                        <div class="d-flex flex-wrap gap-3 small">
                            <span class="legend-item"><i class="legend-dot dot-sep"></i>Separação</span>
                            <span class="legend-item"><i class="legend-dot dot-conf"></i>Conferência</span>
                            <span class="legend-item"><i class="legend-dot dot-exp"></i>Expedição</span>
                        </div>
                    </div>

                    @if (!dados.EtapasPorFuncionario.Any())
                    {
                        <p class="text-muted small mb-0">Nenhuma etapa concluída registrada.</p>
                    }
                    else
                    {
                        int maxEtapas = Math.Max(1, dados.EtapasPorFuncionario.Max(e => e.TotalEtapas));

                        <div class="bar-chart-list">
                            @foreach (var item in dados.EtapasPorFuncionario)
                            {
                                double pctSep = (double)item.SeparacoesFinalizadas / maxEtapas * 100.0;
                                double pctConf = (double)item.ConferenciasFinalizadas / maxEtapas * 100.0;
                                double pctExp = (double)item.ExpedicoesFinalizadas / maxEtapas * 100.0;

                                <div class="bar-row">
                                    <div class="bar-row-header">
                                        <span class="fw-semibold">@item.NomeFuncionario</span>
                                        <span class="small text-muted tabular-nums">
                                            Sep: @item.SeparacoesFinalizadas | Conf: @item.ConferenciasFinalizadas | Exp: @item.ExpedicoesFinalizadas
                                            <strong class="text-dark ms-2">Total: @item.TotalEtapas</strong>
                                        </span>
                                    </div>
                                    <div class="stacked-bar-track">
                                        @if (item.SeparacoesFinalizadas > 0)
                                        {
                                            <div class="stacked-segment seg-sep"
                                                 style="width: @pctSep.ToString("F2", CultureInfo.InvariantCulture)%"
                                                 title="Separação: @item.SeparacoesFinalizadas"></div>
                                        }
                                        @if (item.ConferenciasFinalizadas > 0)
                                        {
                                            <div class="stacked-segment seg-conf"
                                                 style="width: @pctConf.ToString("F2", CultureInfo.InvariantCulture)%"
                                                 title="Conferência: @item.ConferenciasFinalizadas"></div>
                                        }
                                        @if (item.ExpedicoesFinalizadas > 0)
                                        {
                                            <div class="stacked-segment seg-exp"
                                                 style="width: @pctExp.ToString("F2", CultureInfo.InvariantCulture)%"
                                                 title="Expedição: @item.ExpedicoesFinalizadas"></div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Gráfico 2: Pizza - Erros em relação ao limite máximo (10) -->
            <div class="col-lg-6">
                <div class="panel-card h-100">
                    <h2 class="section-heading mb-1">Erros em Relação ao Limite Máximo (10)</h2>
                    <p class="text-muted small mb-4">Monitoramento de ocorrências frente ao teto operacional permitido</p>

                    @{
                        int erros = Math.Min(dados.ErrosTotais, dados.LimiteMaximoErros);
                        int margem = Math.Max(0, dados.LimiteMaximoErros - erros);
                        double pctErro = (double)erros / dados.LimiteMaximoErros * 100.0;
                        string corFatiaErro = erros >= 8 ? "#b91c1c" : (erros >= 5 ? "#b45309" : "#1d4ed8");
                    }

                    <div class="pie-layout">
                        <div class="pie-chart"
                             style="background: conic-gradient(@corFatiaErro 0% @pctErro.ToString("F1", CultureInfo.InvariantCulture)%, #e2e8f0 @pctErro.ToString("F1", CultureInfo.InvariantCulture)% 100%);">
                            <div class="pie-center">
                                <span class="pie-center-main tabular-nums">@dados.ErrosTotais / @dados.LimiteMaximoErros</span>
                                <span class="pie-center-sub">erros</span>
                            </div>
                        </div>

                        <div class="pie-details">
                            <div class="detail-line">
                                <span class="legend-item">
                                    <i class="legend-dot" style="background-color: @corFatiaErro;"></i>
                                    Erros registrados
                                </span>
                                <strong class="tabular-nums">@dados.ErrosTotais (@($"{pctErro:N0}%"))</strong>
                            </div>
                            <div class="detail-line">
                                <span class="legend-item">
                                    <i class="legend-dot" style="background-color: #e2e8f0;"></i>
                                    Margem disponível até o limite
                                </span>
                                <strong class="tabular-nums">@margem</strong>
                            </div>
                            <div class="mt-3 pt-2 border-top small text-muted">
                                Limite máximo estabelecido: <strong>10 ocorrências</strong> no escopo avaliado.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráfico 3: Acurácia de Pedidos (Meta 98% vs Acurácia Total) -->
            <div class="col-lg-6">
                <div class="panel-card h-100">
                    <h2 class="section-heading mb-1">Acurácia de Pedidos vs. Meta (98%)</h2>
                    <p class="text-muted small mb-4">Comparativo de entregas finalizadas dentro e fora do prazo operacional</p>

                    @{
                        bool atingiuMeta = dados.AcuraciaTotalPedidosPercentual >= dados.MetaAcuraciaPercentual;
                        int totalAvaliados = dados.PedidosFinalizadosNoPrazo + dados.PedidosFinalizadosForaPrazo;
                    }

                    <div class="accuracy-bars mb-4">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">Meta Operacional</span>
                                <span class="fw-semibold tabular-nums">@($"{dados.MetaAcuraciaPercentual:N1}%")</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill fill-target"
                                     style="width: @dados.MetaAcuraciaPercentual.ToString("F1", CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">Acurácia Total Alcançada</span>
                                <span class="fw-semibold tabular-nums @(atingiuMeta ? "text-success" : "text-danger")">
                                    @($"{dados.AcuraciaTotalPedidosPercentual:N1}%")
                                </span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill @(atingiuMeta ? "fill-ok" : "fill-warn")"
                                     style="width: @dados.AcuraciaTotalPedidosPercentual.ToString("F1", CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 pt-2 border-top">
                        <div class="col-6">
                            <div class="mini-stat">
                                <span class="mini-stat-label">Finalizados no prazo</span>
                                <span class="mini-stat-value text-success tabular-nums">@dados.PedidosFinalizadosNoPrazo</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mini-stat">
                                <span class="mini-stat-label">Finalizados fora do prazo</span>
                                <span class="mini-stat-value text-danger tabular-nums">@dados.PedidosFinalizadosForaPrazo</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <span class="small text-muted">
                                Base de cálculo: <strong>@totalAvaliados</strong> pedidos expedidos no escopo.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

<!-- Gaveta Lateral Expandivel do ADM: Solicitações de Devolução -->
@if (gavetaAberta)
{
    <div class="position-fixed top-0 start-0 w-100 h-100" style="background: rgba(15, 23, 42, 0.55); z-index: 1050;" @onclick="FecharGaveta">
        <div class="bg-white h-100 shadow-lg ms-auto d-flex flex-column" style="width: 100%; max-width: 580px;" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div>
                    <h5 class="fw-bold mb-0">Solicitações de Devolução (@devolucoes.Count)</h5>
                    <span class="small text-muted">Análise, autorização e acompanhamento em tempo real</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CarregarDevolucoesAsync" title="Atualizar status">
                        <i class="bi bi-arrow-clockwise me-1"></i>Atualizar
                    </button>
                    <button type="button" class="btn-close" @onclick="FecharGaveta"></button>
                </div>
            </div>

            <div class="p-3 overflow-auto flex-grow-1">
                @if (!string.IsNullOrEmpty(feedbackGaveta))
                {
                    <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center">
                        <span>@feedbackGaveta</span>
                        <button type="button" class="btn-close btn-sm" @onclick="() => feedbackGaveta = null"></button>
                    </div>
                }

                @if (!devolucoes.Any())
                {
                    <p class="text-muted small text-center py-4">Nenhuma solicitação de devolução registrada.</p>
                }
                else
                {
                    @foreach (var dev in devolucoes)
                    {
                        <div class="card mb-3 border shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="fw-bold">Devolução #@dev.Id.ToString("D4")</span>
                                        <span class="text-muted small ms-2">• Pedido #@dev.PedidoId</span>
                                    </div>
                                    <span class="badge @ObterBadgeStatusDevolucao(dev.Status)">@dev.Status</span>
                                </div>

                                <div class="small mb-2">
                                    <div><strong>Cliente:</strong> @dev.ClienteNome (@dev.DocumentoCliente)</div>
                                    <div><strong>Motivo:</strong> @dev.MotivoGeral</div>
                                    <div><strong>Volumes informados:</strong> @dev.VolumesInformados</div>
                                    @if (dev.EmiteNotaFiscal)
                                    {
                                        <div class="text-primary"><strong>NF de Devolução:</strong> @dev.NumeroNotaDevolucao</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(dev.CodigoAutorizacao))
                                    {
                                        <div class="text-success"><strong>Código Gerado (Enviar ao Cliente PF):</strong> <code>@dev.CodigoAutorizacao</code></div>
                                    }
                                    else
                                    {
                                        <div class="text-muted"><strong>Modalidade:</strong> Pessoa Física (Código será gerado ao autorizar)</div>
                                    }
                                </div>

                                <div class="bg-light rounded p-2 mb-2 small">
                                    <div class="fw-semibold mb-1">Itens solicitados:</div>
                                    @foreach (var item in dev.Itens)
                                    {
                                        <div class="d-flex justify-content-between">
                                            <span>@item.CodItem — @item.Nome</span>
                                            <strong>Qtd: @item.QuantidadeSolicitada</strong>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(dev.MotivoRejeicao))
                                {
                                    <div class="alert alert-danger py-1 px-2 small mb-2">
                                        <strong>Motivo:</strong> @dev.MotivoRejeicao
                                    </div>
                                }

                                @if (dev.Status == "Pendente Analise")
                                {
                                    @if (devIdRejeitando == dev.Id)
                                    {
                                        <div class="mt-2">
                                            <input type="text" class="form-control form-control-sm mb-2" @bind="motivoRejeicaoInput" placeholder="Informe o motivo da recusa..." />
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => ConfirmarRejeicaoAsync(dev.Id)">Confirmar Recusa</button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => devIdRejeitando = null">Cancelar</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 mt-2">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="() => AutorizarDevolucaoAsync(dev.Id)">
                                                Autorizar Devolução
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => IniciarRejeicao(dev.Id)">
                                                Não Autorizar
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private AdmDashboardDto? dados;
    private string funcionarioSelecionado = "Todos";
    private bool carregando = true;
    private string? erroConexao;
    private bool exportandoAvariados;

    // Estado da gaveta lateral de Devolucoes
    private bool gavetaAberta;
    private List<DevolucaoDto> devolucoes = new();
    private int qtdDevolucoesPendentes;
    private string? feedbackGaveta;
    private int? devIdRejeitando;
    private string motivoRejeicaoInput = string.Empty;

    private string LinkExternoDevolucao => Sessao.UsarMock ? "/solicitar-devolucao?mock=1" : "/solicitar-devolucao";

    protected override async Task OnInitializedAsync()
    {
        if (!Sessao.Autenticado || Sessao.Perfil != PerfilAcesso.Adm)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CarregarDashboardAsync("Todos");
        await CarregarDevolucoesAsync();
    }

    private async Task AoAlterarFuncionario(ChangeEventArgs e)
    {
        funcionarioSelecionado = e.Value?.ToString() ?? "Todos";
        await CarregarDashboardAsync(funcionarioSelecionado);
    }

    private async Task CarregarDashboardAsync(string funcionario)
    {
        carregando = true;
        erroConexao = null;

        var resultado = await AdmService.ObterDashboardAsync(funcionario);

        if (resultado.Sucesso)
        {
            dados = resultado.Dados;
        }
        else
        {
            erroConexao = resultado.MensagemErro;
        }

        carregando = false;
    }

    private async Task CarregarDevolucoesAsync()
    {
        var resDev = await DevolucoesService.ListarDevolucoesAsync();
        if (resDev.Sucesso)
        {
            devolucoes = resDev.Lista;
            qtdDevolucoesPendentes = devolucoes.Count(d => d.Status == "Pendente Analise");
        }
    }

    private async Task AbrirGavetaDevolucoesAsync()
    {
        feedbackGaveta = null;
        devIdRejeitando = null;
        await CarregarDevolucoesAsync();
        gavetaAberta = true;
    }

    private void FecharGaveta()
    {
        gavetaAberta = false;
        devIdRejeitando = null;
    }

    private async Task AutorizarDevolucaoAsync(int id)
    {
        var (sucesso, dev, erro) = await DevolucoesService.AnalisarDevolucaoAsync(id, true, Sessao.NomeUsuario);
        if (sucesso && dev != null)
        {
            feedbackGaveta = dev.EmiteNotaFiscal
                ? $"Devolução #{dev.Id:D4} autorizada! O operador no app deverá bipar a NF '{dev.NumeroNotaDevolucao}'."
                : $"Devolução #{dev.Id:D4} autorizada! Código gerado para o cliente: {dev.CodigoAutorizacao}.";
            await CarregarDevolucoesAsync();
        }
        else
        {
            feedbackGaveta = erro ?? "Erro ao autorizar devolução.";
        }
    }

    private void IniciarRejeicao(int id)
    {
        devIdRejeitando = id;
        motivoRejeicaoInput = string.Empty;
    }

    private async Task ConfirmarRejeicaoAsync(int id)
    {
        var (sucesso, _, erro) = await DevolucoesService.AnalisarDevolucaoAsync(id, false, Sessao.NomeUsuario, motivoRejeicaoInput);
        if (sucesso)
        {
            devIdRejeitando = null;
            feedbackGaveta = $"Devolução #{id:D4} não autorizada.";
            await CarregarDevolucoesAsync();
        }
        else
        {
            feedbackGaveta = erro ?? "Informe o motivo da recusa.";
        }
    }

    private async Task BaixarPlanilhaAvariadosAsync()
    {
        exportandoAvariados = true;
        try
        {
            var resAv = await DevolucoesService.ListarAvariadosAsync();
            var lista = resAv.Sucesso ? resAv.Lista : new List<ProdutoAvariadoDto>();

            if (!string.IsNullOrWhiteSpace(funcionarioSelecionado) &&
                !funcionarioSelecionado.Equals("Todos", StringComparison.OrdinalIgnoreCase))
            {
                lista = lista
                    .Where(a => string.Equals(a.RegistradoPor, funcionarioSelecionado, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            var culturaBr = new CultureInfo("pt-BR");
            var csv = new StringBuilder();
            csv.AppendLine("ID Registro;SKU;Produto;Quantidade Avariada;Origem;ID Devolucao;ID Pedido;Motivo da Avaria;Registrado Por;Data e Hora Registro");

            foreach (var av in lista.OrderByDescending(x => x.DataRegistro))
            {
                string sku = (av.CodItem ?? "-").Replace(";", ",");
                string nome = (av.Nome ?? "-").Replace(";", ",");
                string origem = (av.Origem ?? "-").Replace(";", ",");
                string devId = av.DevolucaoId.HasValue ? $"#{av.DevolucaoId.Value:D4}" : "-";
                string pedId = av.PedidoId.HasValue ? $"#{av.PedidoId.Value:D4}" : "-";
                string motivo = string.IsNullOrWhiteSpace(av.MotivoAvaria) ? "-" : av.MotivoAvaria.Replace(";", ",");
                string operadorReg = string.IsNullOrWhiteSpace(av.RegistradoPor) ? "-" : av.RegistradoPor.Replace(";", ",");
                string dataReg = av.DataRegistro.ToString("yyyy-MM-dd HH:mm:ss", culturaBr);

                csv.AppendLine($"{av.Id};{sku};{nome};{av.Quantidade};{origem};{devId};{pedId};{motivo};{operadorReg};{dataReg}");
            }

            byte[] bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
            string base64 = Convert.ToBase64String(bytes);
            string nomeArquivo = $"Relatorio_Avariados_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const link = document.createElement('a');
                    link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
                    link.download = '{nomeArquivo}';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }})();
            ");
        }
        finally
        {
            exportandoAvariados = false;
        }
    }

    private static string ObterBadgeStatusDevolucao(string status) => status switch
    {
        "Pendente Analise" => "bg-warning text-dark",
        "Autorizada" => "bg-primary",
        "Volumes Conferidos" or "Em Classificação" => "bg-info text-dark",
        "Concluida" => "bg-success",
        "Rejeitada" or "Recusada na Doca" => "bg-danger",
        _ => "bg-secondary"
    };

    private void Sair()
    {
        Sessao.EncerrarSessao();
        Navigation.NavigateTo("/login");
    }

    private static string FormatarMinutos(double minutos)
    {
        if (minutos < 60)
            return $"{minutos:N1} min";

        int horas = (int)(minutos / 60);
        int minsRestantes = (int)Math.Round(minutos % 60);
        return $"{horas}h {minsRestantes:D2}min";
    }
}