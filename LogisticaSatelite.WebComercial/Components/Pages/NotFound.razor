@page "/not-found"
@inject NavigationManager Navigation

<PageTitle>Página não encontrada — Logística Satélite</PageTitle>

<div class="login-wrapper">
    <div class="login-card text-center">
        <h1 class="h4 fw-bold mb-2">Página não encontrada</h1>
        <p class="text-muted small mb-4">O endereço acessado não existe neste sistema.</p>
        <button type="button" class="btn btn-primary-custom" @onclick="@(() => Navigation.NavigateTo("/login"))">
            Voltar ao início
        </button>
    </div>
</div>