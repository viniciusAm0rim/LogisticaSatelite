@page "/pesquisa"
@rendermode InteractiveServer
@using LogisticaSatelite.WebComercial.Models
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark">Consulta de Pedidos (Comercial)</h3>
        <div>
            <span class="badge @(UsandoMock ? "bg-warning text-dark" : "bg-primary") px-3 py-2 me-2">
                @(UsandoMock ? "Modo Mock (Offline)" : "API Conectada")
            </span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="AlternarModoMock">
                @(UsandoMock ? "Tentar Conectar API" : "Forçar Modo Mock")
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <div class="d-flex gap-2">
            <input type="text" class="form-control" @bind="TermoPesquisa" placeholder="Pesquisar por ID do pedido ou Nome do cliente..." />
            <button class="btn btn-primary px-4 fw-bold" @onclick="PesquisarPedidos">Pesquisar</button>
        </div>
    </div>

    @if (IsCarregando)
    {
        <div class="text-center text-secondary mt-5">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            <em>Buscando informações...</em>
        </div>
    }
    else if (PedidosFiltrados != null && PedidosFiltrados.Any())
    {
        <div class="card border-0 shadow-sm">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Cliente</th>
                        <th>Modal</th>
                        <th>Status Atual</th>
                        <th class="text-end pe-4">Ação / Estimativa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in PedidosFiltrados)
                    {
                        <tr>
                            <td class="align-middle ps-4 fw-bold text-secondary">#@pedido.Id.ToString("D4")</td>
                            <td class="align-middle fw-semibold text-dark">@pedido.Destinatario</td>
                            <td class="align-middle text-secondary">@pedido.Modal</td>
                            <td class="align-middle">
                                <span class="badge bg-warning text-dark px-2 py-1">@pedido.Status</span>
                            </td>
                            <td class="align-middle text-end pe-4">
                                @if (!string.IsNullOrEmpty(pedido.DataHoraEstimada))
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6"> @pedido.DataHoraEstimada</span>
                                }
                                else if (pedido.EstimativaSolicitada)
                                {
                                    <button class="btn btn-sm btn-secondary opacity-50" disabled>
                                        ✓ Solicitado
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-dark" @onclick="() => SolicitarEstimativa(pedido)">
                                        Solicitar Estimativa
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (PedidosFiltrados != null && !PedidosFiltrados.Any())
    {
        <div class="alert alert-light border text-center text-secondary py-4">Nenhum pedido encontrado com este termo.</div>
    }
</div>

@code {
    private string TermoPesquisa { get; set; } = "";
    private bool IsCarregando { get; set; } = false;
    private bool UsandoMock { get; set; } = false;
    private List<Pedido> PedidosFiltrados = null;

    private List<Pedido> PedidosMockList = new()
    {
        new Pedido { Id = 1, Destinatario = "Vinicius Amorim", Status = "Aguardando", Modal = "Transportadora", EstimativaSolicitada = false },
        new Pedido { Id = 2, Destinatario = "Vinicius Ferreira", Status = "Em Separaçao", Modal = "Retira", EstimativaSolicitada = false },
        new Pedido { Id = 3, Destinatario = "Vinicius Amorim", Status = "Aguardando Conferencia", Modal = "Transportadora", EstimativaSolicitada = false }
    };

    protected override async Task OnInitializedAsync()
    {
        await PesquisarPedidos();
    }

    private void AlternarModoMock()
    {
        UsandoMock = !UsandoMock;
        _ = PesquisarPedidos();
    }

    private async Task PesquisarPedidos()
    {
        IsCarregando = true;
        PedidosFiltrados = null;
        List<Pedido> todosPedidos = new();

        if (!UsandoMock)
        {
            try
            {
                var resultado = await Http.GetFromJsonAsync<List<Pedido>>("api/Pedidos");
                if (resultado != null) todosPedidos = resultado;
                else { UsandoMock = true; todosPedidos = PedidosMockList; }
            }
            catch
            {
                UsandoMock = true;
                todosPedidos = PedidosMockList;
            }
        }
        else
        {
            todosPedidos = PedidosMockList;
        }

        // REGRA 1: Ocultar pedidos com status "Expedido"
        todosPedidos = todosPedidos
            .Where(p => !string.Equals(p.Status, "Expedido", StringComparison.OrdinalIgnoreCase))
            .ToList();

        string termoBase = TermoPesquisa.Trim().ToLower();

        if (string.IsNullOrEmpty(termoBase))
        {
            PedidosFiltrados = todosPedidos;
        }
        else
        {
            PedidosFiltrados = todosPedidos.Where(p =>
                p.Id.ToString() == termoBase ||
                (p.Destinatario != null && p.Destinatario.ToLower().Contains(termoBase))
            ).ToList();
        }

        IsCarregando = false;
    }

    // REGRA 2 & 3: Comunicação real com a API ao solicitar a estimativa
    private async Task SolicitarEstimativa(Pedido pedido)
    {
        if (UsandoMock)
        {
            // Comportamento local para o Modo Mock
            pedido.EstimativaSolicitada = true;
            pedido.SolicitanteEstimativa = "Comercial (Web)";
            StateHasChanged();
            return;
        }

        try
        {
            var response = await Http.PatchAsync($"api/Pedidos/{pedido.Id}/solicitar-estimativa", null);
            if (response.IsSuccessStatusCode)
            {
                // Atualiza localmente e recarrega os dados da API
                pedido.EstimativaSolicitada = true;
                pedido.SolicitanteEstimativa = "Comercial (Web)";
                StateHasChanged();
            }
            else
            {
                // Tratamento simples caso dê erro na API
                pedido.EstimativaSolicitada = true;
                StateHasChanged();
            }
        }
        catch
        {
            pedido.EstimativaSolicitada = true;
            StateHasChanged();
        }
    }
}