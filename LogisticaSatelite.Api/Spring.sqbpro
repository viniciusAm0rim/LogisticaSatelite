ALTER TABLE Pedidos ADD COLUMN PausadoPor TEXT;
ALTER TABLE Pedidos ADD COLUMN DataHoraPausa TEXT;

CREATE TABLE IF NOT EXISTS RegistrosPausas (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    PedidoId INTEGER NOT NULL,
    Etapa TEXT NOT NULL,
    OperadorPausa TEXT NOT NULL,
    DataHoraPausa TEXT NOT NULL,
    OperadorRetomada TEXT,
    DataHoraRetomada TEXT,
    CONSTRAINT FK_RegistrosPausas_Pedidos_PedidoId FOREIGN KEY (PedidoId) REFERENCES Pedidos (Id) ON DELETE CASCADE
);

