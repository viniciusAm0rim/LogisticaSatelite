UPDATE Produtos
SET UnidadepCx = 25,
    CodCaixaFechada = 'CX-SKU-001',
    LocalPicking = 'R1-A-01',
    LocalPulmao = 'A1-P2',
    QtdPicking = 40,
    QtdMinimaPicking = 10,
    QtdCxAbaste = 2,
    TipoRota = 0
WHERE CodItem = 'SKU-001';

-- Demais itens permanecem como unitários de rua até você definir caixa fechada para eles
UPDATE Produtos
SET UnidadepCx = 1,
    CodCaixaFechada = '',
    QtdPicking = 30,
    QtdMinimaPicking = 5,
    QtdCxAbaste = 1,
    TipoRota = 0
WHERE CodItem = 'SKU-002';

UPDATE Produtos
SET UnidadepCx = 1,
    CodCaixaFechada = '',
    QtdPicking = 15,
    QtdMinimaPicking = 3,
    QtdCxAbaste = 1,
    TipoRota = 1
WHERE CodItem = 'SKU-003';


select * from Produtos
</sql><current_tab id="0"/></tab_sql></sqlb_project>
