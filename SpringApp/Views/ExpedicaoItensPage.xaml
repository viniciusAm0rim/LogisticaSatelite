<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.ExpedicaoItensPage"
             Title="Expedir Pedido">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15" RowSpacing="12">

        <!-- 1. Card Indicador Principal: Total de Volumes Pendentes -->
        <Frame Grid.Row="0" BackgroundColor="#fef3c7" BorderColor="#d97706" Padding="15" CornerRadius="8" HasShadow="False">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="TOTAL DE VOLUMES A EXPEDIR" FontSize="11" TextColor="#b45309" FontAttributes="Bold"/>
                    <Label x:Name="VolumesRestantesLabel" Text="0 de 0" FontSize="26" FontAttributes="Bold" TextColor="#d97706"/>
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="🚚" FontSize="32" VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- 2. Card de Informações: Cliente e Subtítulo (Separador/Conferente) -->
        <Frame Grid.Row="1" BackgroundColor="#004aad" Padding="15" CornerRadius="8" HasShadow="False">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="NumeroPedidoLabel" Text="Pedido #000" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Label x:Name="ClienteLabel" Text="Cliente: Carregando..." FontSize="14" FontAttributes="Bold" TextColor="#ffffff"/>
                <Label x:Name="SubtituloResponsavelLabel" Text="Resp: -" FontSize="12" TextColor="#cbd5e1"/>
            </VerticalStackLayout>
        </Frame>

        <!-- 3. Leitor de Código de Barras -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="CodigoBarraEntry" 
                   Placeholder="Bipe o pedido ou o volume..." 
                   Completed="OnBiparCompleted" 
                   ReturnType="Done"/>
            <Button Grid.Column="1" 
                    Text="Expedir" 
                    Clicked="OnBiparClicked" 
                    BackgroundColor="#d97706" 
                    TextColor="White"/>
        </Grid>

        <!-- 4. Lista de Volumes -->
        <CollectionView Grid.Row="3" x:Name="PedidoCollectionView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4,0,8" Padding="15" CornerRadius="8" BorderColor="#cbd5e1" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Numero, StringFormat='Pedido: {0}'}" FontAttributes="Bold" FontSize="16" TextColor="#1e293b"/>
                                <Label Text="{Binding Destinatario, StringFormat='Destino: {0}'}" FontSize="13" TextColor="#64748b"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="Progresso do Volume:" FontSize="13" TextColor="#64748b"/>
                                <Label Text="{Binding StatusProgressoVolume}" FontSize="13" FontAttributes="Bold" TextColor="#d97706"/>
                            </HorizontalStackLayout>

                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="Baixar Volume" 
                                    Clicked="OnExpedirVolumeDiretoClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#d97706"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="6"
                                    HeightRequest="44"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>