<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.AvariadosPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="14">
            <!-- Cabecalho sem BoxView preto -->
            <Border Grid.Row="0" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Clicked="OnVoltarClicked"
                            BackgroundColor="#f1f5f9"
                            TextColor="#334155"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="12"
                            Padding="0">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xe5c4;" FontFamily="MaterialIcons" Color="#334155" Size="20"/>
                        </Button.ImageSource>
                    </Button>

                    <Label Grid.Column="1"
                           Text="PRODUTOS AVARIADOS"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0f172a"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           Margin="0,0,40,0"/>
                </Grid>
            </Border>

            <!-- Botao para bipar produto quebrado encontrado diretamente no estoque -->
            <Button Grid.Row="1"
                    Text="+ Bipar Produto Avariado no Estoque"
                    Clicked="OnAbrirModalRegistrarAvariaClicked"
                    BackgroundColor="#dc2626"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="46"/>

            <!-- Lista de todos os produtos avariados -->
            <RefreshView Grid.Row="2"
                         x:Name="AvariadosRefreshView"
                         Refreshing="OnRefreshing"
                         RefreshColor="#334155">
                <CollectionView x:Name="AvariadosCollectionView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="&#xe002;" FontFamily="MaterialIcons" FontSize="38" HorizontalOptions="Center" TextColor="#94a3b8"/>
                            <Label Text="Nenhum produto avariado registrado." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Stroke="#fecaca" StrokeThickness="1" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Nome}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0f172a"/>

                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#fee2e2" Stroke="Transparent" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#dc2626"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                        <Label Text="{Binding Origem, StringFormat='Origem: {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                        <Label Text="{Binding MotivoAvaria, StringFormat='Motivo: {0}'}" FontSize="11" TextColor="#64748b"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Modal de Registro Direto de Avaria no Estoque -->
        <Grid x:Name="OverlayRegistrarAvaria" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="20" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Registrar Avaria no Estoque" FontAttributes="Bold" FontSize="17" TextColor="#0f172a" HorizontalOptions="Center"/>
                    <Label Text="A quantidade informada será descontada do estoque e adicionada à lista de avariados." FontSize="11" TextColor="#64748b" HorizontalTextAlignment="Center"/>

                    <Label Text="SKU / Código do Produto:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <Entry x:Name="SkuAvariaEntry" Placeholder="Bipe ou digite o SKU (Ex: 001)" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Label Text="Quantidade Avariada:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <Entry x:Name="QtdAvariaEntry" Text="1" Keyboard="Numeric" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Label Text="Motivo da Avaria:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <Entry x:Name="MotivoAvariaEntry" Placeholder="Ex: Caixa amassada, produto quebrado..." BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarAvariaClicked" BackgroundColor="#64748b" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarAvariaClicked" BackgroundColor="#dc2626" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>