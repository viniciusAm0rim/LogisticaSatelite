<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.AbastecimentoPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,15" RowSpacing="15">

        <!-- Header Superior com Seta de Voltar -->
        <HorizontalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center">
            <Label Text="←" FontSize="22" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarTapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Recomendações de Abastecimento" FontSize="20" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Card 1: Total de Itens a Repor -->
        <Border Grid.Row="1" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="20,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <Label Text="ITENS CRÍTICOS PENDENTES" FontSize="11" FontAttributes="Bold" TextColor="#94a3b8"/>
                <Label x:Name="TotalCriticosLabel" Text="0 itens" FontSize="28" FontAttributes="Bold" TextColor="#dc2626"/>
            </VerticalStackLayout>
        </Border>

        <!-- Título da Seção -->
        <Label Grid.Row="2" Text="REPOSIÇÕES RECOMENDADAS" FontSize="12" FontAttributes="Bold" TextColor="#64748b" Margin="0,5,0,-5"/>

        <!-- Lista de Cards Recomendados -->
        <CollectionView Grid.Row="3" x:Name="RecomendacoesCollectionView" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                    <Label Text="✅" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="Nenhum item precisando de abastecimento." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="16" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="6">

                            <!-- Nome do Item -->
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="15" TextColor="#0f172a"/>

                            <!-- Local de Retirada no Pulmão -->
                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#eff6ff" Stroke="Transparent" Padding="8,3" HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding LocalizacaoPulmaoFormatada}" FontSize="11" FontAttributes="Bold" TextColor="#2563eb"/>
                            </Border>

                            <!-- Destino no Picking -->
                            <Label Grid.Row="2" Grid.Column="0" Text="{Binding LocalizacaoPickingFormatada, StringFormat='Destino: {0}'}" FontSize="12" TextColor="#64748b"/>

                            <!-- Caixas a Repor -->
                            <Label Grid.Row="3" Grid.Column="0" Text="{Binding CaixasPendentesTexto, StringFormat='Necessário: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#dc2626"/>

                            <!-- Botão de Reposição -->
                            <Button Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                                    Text="Repor"
                                    Clicked="OnAbastecerClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#2563eb"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="10"
                                    HeightRequest="42"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>