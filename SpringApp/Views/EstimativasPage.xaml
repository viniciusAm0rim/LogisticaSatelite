<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.EstimativasPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="14">
            <!-- Cabecalho da pagina de estimativas -->
            <Border Grid.Row="0" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Clicked="OnVoltarClicked"
                            BackgroundColor="#f1f5f9"
                            TextColor="#334155"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="12"
                            Padding="0">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xe5c4;" FontFamily="MaterialIcons" Color="#334155" Size="20"/>
                        </Button.ImageSource>
                    </Button>

                    <Label Grid.Column="1"
                           Text="ESTIMATIVAS PENDENTES"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0f172a"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           Margin="0,0,40,0"/>
                </Grid>
            </Border>

            <!-- Lista de pedidos na fila aguardando estimativa -->
            <RefreshView Grid.Row="1"
                         x:Name="EstimativasRefreshView"
                         Refreshing="OnRefreshing"
                         RefreshColor="#334155">
                <CollectionView x:Name="EstimativasCollectionView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="38" HorizontalOptions="Center" TextColor="#94a3b8"/>
                            <Label Text="Nenhuma estimativa pendente." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Label Text="Puxe para baixo para atualizar" FontSize="12" TextColor="#94a3b8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding IdPedido, StringFormat='Pedido #{0:D4}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0f172a"
                                           VerticalOptions="Center"/>

                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#f1f5f9" Stroke="Transparent" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                    </Border>

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding DescricaoPendenciaEstimativa}"
                                           FontSize="12"
                                           TextColor="#d97706"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>

                                    <Button Grid.Row="1" Grid.Column="1"
                                            Text="Responder"
                                            Clicked="OnAbrirFichaEstimativaClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#10b981"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HeightRequest="38"
                                            WidthRequest="110"
                                            CornerRadius="10"
                                            FontSize="12"
                                            Padding="0"
                                            VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Ficha tecnica do pedido para responder estimativa -->
        <Grid x:Name="OverlayEstimativa" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="20" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340" MaximumHeightRequest="560">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Estimativa de Entrega" FontAttributes="Bold" FontSize="17" TextColor="#0f172a" HorizontalOptions="Center"/>
                        <Label x:Name="LabelPedidoEstimativa" Text="Pedido #0000" FontSize="14" FontAttributes="Bold" TextColor="#334155" HorizontalOptions="Center"/>

                        <!-- Mostra apenas o separador e a hora estimada quando estiver na conferencia -->
                        <Border x:Name="BoxInfoSeparadorEstimativa" IsVisible="False" BackgroundColor="#eff6ff" Stroke="#bfdbfe" StrokeThickness="1" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="LabelInfoSeparadorEstimativa" FontSize="13" TextColor="#1e40af" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        </Border>

                        <!-- Lista resumida dos itens do pedido para avaliar o volume -->
                        <Label Text="Itens do Pedido:" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                        <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="#f8fafc" Padding="8" MaximumHeightRequest="150">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <CollectionView x:Name="ItensFichaEstimativaView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="4,3">
                                            <Label Grid.Column="0" Text="{Binding Nome}" FontSize="12" TextColor="#0f172a" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1" Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <Label Text="Data Estimada:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <DatePicker x:Name="EstimativaDatePicker" Format="dd/MM/yyyy" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                        <Label Text="Horário Estimado:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <TimePicker x:Name="EstimativaTimePicker" Format="HH:mm" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                            <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarEstimativaClicked" BackgroundColor="#ef4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                            <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarEstimativaClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>