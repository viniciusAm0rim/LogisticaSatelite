<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.ConferenciaItensPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid RowDefinitions="*, Auto" RowSpacing="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTelaTapped" />
        </Grid.GestureRecognizers>

        <!-- Campo oculto que mantem o foco do leitor de codigo de barras -->
        <Entry x:Name="LeitorBluetoothEntry"
               Grid.Row="0"
               ZIndex="-1"
               Opacity="0.01"
               HeightRequest="40"
               WidthRequest="200"
               Margin="20,15,0,0"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Loaded="OnLeitorLoaded"
               Completed="OnCodigoScaneadoCompleted"
               TextChanged="OnLeitorTextChanged"
               Unfocused="OnLeitorUnfocused"/>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,15" Spacing="15">

                <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label x:Name="TituloPaginaLabel" Text="CONFERIR ITENS" FontSize="16" FontAttributes="Bold" TextColor="#0f172a" HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Card enxuto exibido quando ha estimativa pendente na conferencia -->
                <Border x:Name="CardNotificacaoEstimativaConf"
                        IsVisible="False"
                        Stroke="#f59e0b"
                        StrokeThickness="1.5"
                        BackgroundColor="#fffbeb"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="ESTIMATIVA SOLICITADA" FontSize="11" FontAttributes="Bold" TextColor="#b45309"/>
                            <Label x:Name="LabelAvisoSeparacaoNaConf" Text="Informar previsão" FontSize="12" FontAttributes="Bold" TextColor="#78350f"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Informar"
                                Clicked="OnAbrirModalEstimativaConfClicked"
                                BackgroundColor="#f59e0b"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="38"
                                WidthRequest="90"
                                CornerRadius="10"
                                Padding="0"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Cabecalho do pedido -->
                <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="PEDIDO" FontSize="10" FontAttributes="Bold" TextColor="#94a3b8"/>
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#dcfce7" Stroke="Transparent" Padding="10,4" HorizontalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="ModalLabel" Text="CLIENTE RETIRA" FontSize="11" FontAttributes="Bold" TextColor="#15803d"/>
                        </Border>
                        <Label x:Name="NumeroPedidoLabel" Grid.Row="1" Grid.Column="0" Text="#0001" FontSize="20" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label x:Name="ClienteLabel" Grid.Row="2" Grid.ColumnSpan="2" Text="NOME DO CLIENTE" FontSize="14" FontAttributes="Bold" TextColor="#475569"/>
                    </Grid>
                </Border>

                <!-- Bipagem de itens -->
                <VerticalStackLayout x:Name="ContainerItens" IsVisible="True" Spacing="15">
                    <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Text="ITENS A CONFERIR" FontSize="11" FontAttributes="Bold" TextColor="#94a3b8" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Label x:Name="TotalRestanteLabel" Text="0" FontSize="16" FontAttributes="Bold" TextColor="#0f172a"/>
                                <Label Text="de" FontSize="14" TextColor="#64748b" VerticalOptions="Center"/>
                                <Label x:Name="TotalGeralLabel" Text="0" FontSize="14" TextColor="#64748b" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <Button Text="⌨ DIGITAR CÓDIGO (PRODUTO)" Clicked="OnDigitarCodigoManualClicked" BackgroundColor="#e0f2fe" TextColor="#0369a1" FontAttributes="Bold" FontSize="12" CornerRadius="12" HeightRequest="42"/>

                    <CollectionView x:Name="ItensCollectionView" SelectionMode="None" HeightRequest="350">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="0">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="14" TextColor="#0f172a"/>
                                            <Label Text="{Binding CodItem, StringFormat='Cód: {0}'}" FontSize="11" TextColor="#64748b"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#fef3c7" Stroke="Transparent" Padding="8,2" HorizontalOptions="Start" Margin="0,4,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding LocalPicking}" FontSize="11" FontAttributes="Bold" TextColor="#d97706"/>
                                        </Border>
                                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding ProgressoConferenciaTexto}" FontSize="11" TextColor="#64748b"/>
                                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BackgroundColor="{Binding BotaoConferenciaCorFundo}" Padding="12,6" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding BotaoConferenciaTexto}" TextColor="{Binding BotaoConferenciaCorTexto}" FontAttributes="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Bipagem de volumes -->
                <VerticalStackLayout x:Name="ContainerVolumes" IsVisible="False" Spacing="15">
                    <Border Stroke="#fde68a" StrokeThickness="2" BackgroundColor="#fef3c7" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="Confirme a identificação das caixas lendo as etiquetas de volume geradas." FontSize="13" TextColor="#b45309" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                    </Border>

                    <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="VOLUMES (CAIXAS)" FontSize="11" FontAttributes="Bold" TextColor="#94a3b8" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                    <Label x:Name="VolumesLidosLabel" Text="0" FontSize="14" FontAttributes="Bold" TextColor="#0f172a"/>
                                    <Label Text="de" FontSize="12" TextColor="#64748b" VerticalOptions="Center"/>
                                    <Label x:Name="VolumesTotalLabel" Text="0" FontSize="12" TextColor="#64748b" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="DIGITAR CÓDIGO" Clicked="OnDigitarCodigoManualClicked" BackgroundColor="#e0f2fe" TextColor="#0369a1" FontAttributes="Bold" FontSize="12" CornerRadius="12" HeightRequest="42"/>

                    <CollectionView x:Name="VolumesCollectionView" SelectionMode="None" HeightRequest="250">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding ExibicaoNome}" FontAttributes="Bold" FontSize="14" TextColor="#0f172a"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding CorFundo}" Padding="12,6" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding StatusTexto}" TextColor="{Binding CorTexto}" FontAttributes="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="12" BackgroundColor="#f8fafc" Padding="20,10">
            <Button Grid.Column="0" Text="CANCELAR" Clicked="OnCancelarClicked" BackgroundColor="#fee2e2" TextColor="#ef4444" FontAttributes="Bold" HeightRequest="48" CornerRadius="14"/>
            <Button Grid.Column="1" Text="AGUARDAR" Clicked="OnAguardarClicked" BackgroundColor="#fef3c7" TextColor="#b45309" FontAttributes="Bold" HeightRequest="48" CornerRadius="14"/>
        </Grid>

        <!-- Modal sobreposto para o conferente informar data e hora final -->
        <Grid x:Name="OverlayEstimativaConf" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="22" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Previsão da Conferência" FontAttributes="Bold" FontSize="17" TextColor="#0f172a" HorizontalOptions="Center"/>
                    <Label x:Name="LabelModalSeparadorConf" Text="" FontSize="13" TextColor="#1e40af" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                    <Label Text="Data Estimada:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <DatePicker x:Name="EstimativaConfDatePicker" Format="dd/MM/yyyy" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Label Text="Horário Estimado:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <TimePicker x:Name="EstimativaConfTimePicker" Format="HH:mm" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarModalEstimativaConfClicked" BackgroundColor="#ef4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarModalEstimativaConfClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal sobreposto de Volumes e Observacoes (unico e igual para todos os modais) -->
        <Grid x:Name="OverlayVolumesObservacao" Grid.RowSpan="2" BackgroundColor="#990f172a" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="22" VerticalOptions="Center" HorizontalOptions="Fill" MaximumWidthRequest="400">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Concluir Conferência" FontAttributes="Bold" FontSize="18" TextColor="#0f172a" HorizontalTextAlignment="Center"/>

                    <!-- Quantidade de Volumes -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Quantidade de Volumes (Caixas)" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <Grid ColumnDefinitions="46, *, 46" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="-" Clicked="OnDiminuirVolumesClicked" BackgroundColor="#e2e8f0" TextColor="#0f172a" FontAttributes="Bold" FontSize="18" CornerRadius="10" HeightRequest="44" Padding="0"/>
                            <Border Grid.Column="1" BackgroundColor="#f8fafc" Stroke="#cbd5e1" StrokeThickness="1" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry x:Name="QtdVolumesEntry"
                                       Text="1"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#0f172a"/>
                            </Border>
                            <Button Grid.Column="2" Text="+" Clicked="OnAumentarVolumesClicked" BackgroundColor="#e2e8f0" TextColor="#0f172a" FontAttributes="Bold" FontSize="18" CornerRadius="10" HeightRequest="44" Padding="0"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Campo Observacoes (valido para todos os modais) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observações" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <Border BackgroundColor="#f8fafc" Stroke="#cbd5e1" StrokeThickness="1" Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Editor x:Name="ObservacaoConferenciaEditor"
                                    Placeholder="Digite observações da conferência (opcional)..."
                                    HeightRequest="100"
                                    FontSize="14"
                                    TextColor="#0f172a"
                                    AutoSize="Disabled"/>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="Voltar" Clicked="OnCancelarModalVolumesObservacaoClicked" BackgroundColor="#f1f5f9" TextColor="#475569" FontAttributes="Bold" CornerRadius="10" HeightRequest="44"/>
                        <Button Grid.Column="1" Text="Concluir" Clicked="OnConfirmarVolumesObservacaoClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="44"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>