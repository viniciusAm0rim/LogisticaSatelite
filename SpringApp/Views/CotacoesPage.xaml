<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.CotacoesPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="14">
            <!-- Cabecalho -->
            <Border Grid.Row="0" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Clicked="OnVoltarClicked"
                            BackgroundColor="#f1f5f9"
                            TextColor="#334155"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="12"
                            Padding="0">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xe5c4;" FontFamily="MaterialIcons" Color="#334155" Size="20"/>
                        </Button.ImageSource>
                    </Button>

                    <Label Grid.Column="1"
                           Text="COTAÇÕES PENDENTES"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0f172a"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           Margin="0,0,40,0"/>
                </Grid>
            </Border>

            <!-- Lista de cotacoes pendentes -->
            <RefreshView Grid.Row="1"
                         x:Name="CotacoesRefreshView"
                         Refreshing="OnRefreshing"
                         RefreshColor="#334155">
                <CollectionView x:Name="CotacoesCollectionView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="38" HorizontalOptions="Center" TextColor="#94a3b8"/>
                            <Label Text="Nenhuma cotação pendente." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Label Text="Puxe para baixo para atualizar" FontSize="12" TextColor="#94a3b8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Id, StringFormat='Cotação #{0:D4}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0f172a"
                                           VerticalOptions="Center"/>

                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#fef3c7" Stroke="Transparent" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#b45309" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Cliente}" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        <Label Text="{Binding ResumoItens}" FontSize="11" TextColor="#64748b"/>
                                        <Label Text="{Binding Observacao, StringFormat='Obs: {0}'}"
                                               IsVisible="{Binding TemObservacao}"
                                               FontSize="11"
                                               TextColor="#d97706"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Row="1" Grid.Column="1"
                                            Text="Responder"
                                            Clicked="OnAbrirFichaCotacaoClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#10b981"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HeightRequest="38"
                                            WidthRequest="110"
                                            CornerRadius="10"
                                            FontSize="12"
                                            Padding="0"
                                            VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Modal de resposta da cotacao (Volumes, Peso e Dimensoes) -->
        <Grid x:Name="OverlayCotacao" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="20" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340" MaximumHeightRequest="590">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Responder Cotação" FontAttributes="Bold" FontSize="17" TextColor="#0f172a" HorizontalOptions="Center"/>
                        <Label x:Name="LabelTituloCotacao" Text="Cotação #0000" FontSize="14" FontAttributes="Bold" TextColor="#334155" HorizontalOptions="Center"/>

                        <Border x:Name="BoxObsCotacao" IsVisible="False" BackgroundColor="#fffbeb" Stroke="#fde68a" StrokeThickness="1" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="LabelObsCotacao" FontSize="12" TextColor="#b45309" FontAttributes="Bold"/>
                        </Border>

                        <!-- Lista dos itens solicitados -->
                        <Label Text="Itens Solicitados:" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                        <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="#f8fafc" Padding="8" MaximumHeightRequest="140">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <CollectionView x:Name="ItensCotacaoView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="4,3">
                                            <Label Grid.Column="0" Text="{Binding Nome}" FontSize="12" TextColor="#0f172a" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1" Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <Label Text="Quantidade de Volumes:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <Entry x:Name="VolumesEntry"
                               Placeholder="Ex: 3"
                               Keyboard="Numeric"
                               BackgroundColor="#f8fafc"
                               TextColor="#0f172a"/>

                        <Label Text="Peso Total (kg):" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <Entry x:Name="PesoEntry"
                               Placeholder="Ex: 18,5"
                               Keyboard="Numeric"
                               BackgroundColor="#f8fafc"
                               TextColor="#0f172a"/>

                        <Label Text="Dimensões / Cubagem:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                        <Entry x:Name="DimensoesEntry"
                               Placeholder="Ex: 2 cx 40x30x25 cm"
                               BackgroundColor="#f8fafc"
                               TextColor="#0f172a"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                            <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarCotacaoClicked" BackgroundColor="#ef4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                            <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarCotacaoClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>