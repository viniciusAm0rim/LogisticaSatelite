<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <!-- Estrutura principal da tela -->
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="16,16,16,85" RowSpacing="12">

            <!-- Topo da tela com menu expansivel (3 barras) a esquerda e perfil a direita -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <!-- Botao das 3 barras com contador de pendencias nao lidas -->
                <Grid Grid.Column="0" WidthRequest="48" HeightRequest="48">
                    <Button Clicked="OnMenuExpansivelClicked"
                            BackgroundColor="#334155"
                            TextColor="White"
                            WidthRequest="44"
                            HeightRequest="44"
                            CornerRadius="12"
                            Padding="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xe5d2;" FontFamily="MaterialIcons" Color="White" Size="22"/>
                        </Button.ImageSource>
                    </Button>

                    <!-- Contador vermelho de notificacoes pendentes -->
                    <Border x:Name="BadgeMenuContainer"
                            IsVisible="False"
                            BackgroundColor="#ef4444"
                            Stroke="White"
                            StrokeThickness="1.5"
                            MinimumWidthRequest="20"
                            HeightRequest="20"
                            Padding="5,0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="BadgeMenuLabel"
                               Text="0"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Botao de perfil a direita -->
                <Button Grid.Column="2" Clicked="OnPerfilClicked" BackgroundColor="#e2e8f0" TextColor="#334155" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xe8b8;" FontFamily="MaterialIcons" Color="#334155" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- Aviso exibido quando a conexao com a API falha ou demora demais -->
            <Border x:Name="BannerConexao"
                    Grid.Row="1"
                    IsVisible="False"
                    Stroke="#fecaca"
                    StrokeThickness="1"
                    BackgroundColor="#fef2f2"
                    Padding="12,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="&#xe000;" FontFamily="MaterialIcons" TextColor="#dc2626" FontSize="18" VerticalOptions="Center"/>
                    <Label x:Name="LabelErroConexao"
                           Grid.Column="1"
                           Text="Sem resposta da API. Puxe para baixo para tentar novamente."
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#991b1b"
                           VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Barra de busca usada apenas na aba de expedicao -->
            <SearchBar x:Name="PesquisaExpedicaoBar" Grid.Row="2" IsVisible="False" Placeholder="Pesquisar Cliente ou Nº Pedido..." SearchButtonPressed="OnPesquisaExpedicaoPesquisar" TextChanged="OnPesquisaExpedicaoTextChanged" BackgroundColor="White" CancelButtonColor="#ef4444" HeightRequest="42" />

            <!-- Bloco de pedidos que foram pausados na etapa atual -->
            <Border x:Name="CardPedidosEmEspera" Grid.Row="3" IsVisible="False" Stroke="#f59e0b" StrokeThickness="1.5" BackgroundColor="#fffbeb" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="&#xe034;" FontFamily="MaterialIcons" TextColor="#d97706" FontSize="18" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="PEDIDOS EM ESPERA" FontSize="11" FontAttributes="Bold" TextColor="#b45309" VerticalOptions="Center"/>
                        <Border Grid.Column="2" BackgroundColor="#fef3c7" Stroke="Transparent" Padding="8,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="ContadorEsperaLabel" Text="0" FontSize="11" FontAttributes="Bold" TextColor="#b45309"/>
                        </Border>
                    </Grid>

                    <!-- Lista de pedidos pausados -->
                    <StackLayout x:Name="ListaPedidosEmEspera" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#fde68a" StrokeThickness="1" BackgroundColor="White" Padding="10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding IdPedido, StringFormat='Pedido #{0:D4}'}" FontAttributes="Bold" FontSize="13" TextColor="#0f172a"/>
                                                <Label Text="{Binding Modal, StringFormat='• {0}'}" FontSize="11" TextColor="#64748b" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Cliente, StringFormat='Cliente: {0}'}" FontSize="12" TextColor="#475569" FontAttributes="Bold"/>
                                            <Label Text="{Binding ResumoProgressoEspera}" FontSize="11" TextColor="#d97706" FontAttributes="Bold"/>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Retomar"
                                                Clicked="OnRetomarPedidoEsperaClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#f59e0b"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                HeightRequest="36"
                                                WidthRequest="92"
                                                CornerRadius="10"
                                                Padding="0"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Area da lista de pedidos com carregamento e puxar para atualizar -->
            <Grid Grid.Row="4">
                <!-- Blocos cinzas exibidos enquanto os dados carregam pela primeira vez -->
                <VerticalStackLayout x:Name="SkeletonLoadingView" IsVisible="False" Spacing="12">
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                </VerticalStackLayout>

                <!-- Permite puxar a lista para baixo para buscar novos pedidos -->
                <RefreshView x:Name="PedidosRefreshView"
                             Refreshing="OnPedidosRefreshing"
                             RefreshColor="#334155">
                    <CollectionView x:Name="PedidosCollectionView" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                                <Label Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="#94a3b8"/>
                                <Label Text="Nenhum pedido nesta fila." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center" FontAttributes="Bold"/>
                                <Label Text="Puxe para baixo para atualizar" FontSize="12" TextColor="#94a3b8" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <!-- Modelo visual de cada card de pedido na fila -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="8">
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding IdPedido, StringFormat='Pedido #{0:D4}'}" FontSize="15" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#f1f5f9" Stroke="Transparent" Padding="8,3">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Cliente, StringFormat='Cliente: {0}'}" FontSize="12" TextColor="#475569" FontAttributes="Bold"/>
                                            <Label Text="{Binding Modal, StringFormat='Via: {0}'}" FontSize="11" TextColor="#64748b"/>
                                            <Label Text="{Binding DescricaoPendenciaEstimativa}" FontSize="11" TextColor="#d97706" FontAttributes="Bold" IsVisible="{Binding EstimativaSolicitada}"/>
                                        </VerticalStackLayout>

                                        <Button Grid.Row="1" Grid.Column="1" Text="Iniciar" Clicked="OnIniciarAcaoClicked" CommandParameter="{Binding .}" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" HeightRequest="38" WidthRequest="110" CornerRadius="10" FontSize="12" Padding="0" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Grid>

        <!-- Menu inferior com as abas de operacao -->
        <Border VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,16" Padding="8,6" BackgroundColor="#334155">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="16" Opacity="0.35"/>
            </Border.Shadow>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <!-- Aba de Separacao -->
                <Grid x:Name="ContainerAbaSeparacao" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillSeparacao" BackgroundColor="#475569" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconSeparacao" Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextSeparacao" Text="Separar" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaSeparacaoBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando" BackgroundColor="Transparent"/>
                </Grid>

                <!-- Aba de Conferencia -->
                <Grid x:Name="ContainerAbaConferencia" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillConferencia" BackgroundColor="Transparent" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconConferencia" Text="&#xe86c;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextConferencia" Text="Conferir" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaConferenciaBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando Conferencia" BackgroundColor="Transparent"/>
                </Grid>

                <!-- Aba de Expedicao -->
                <Grid x:Name="ContainerAbaExpedicao" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillExpedicao" BackgroundColor="Transparent" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconExpedicao" Text="&#xe558;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextExpedicao" Text="Expedir" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaExpedicaoBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando Expediçao" BackgroundColor="Transparent"/>
                </Grid>
            </HorizontalStackLayout>
        </Border>

        <!-- Menu lateral expansivel (3 barras) com funcionalidades em segundo plano -->
        <Grid x:Name="OverlayMenuLateral" BackgroundColor="#800f172a" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BackgroundColor="White" Stroke="Transparent" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <!-- Cabecalho do menu lateral -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                        <Label Grid.Column="0" Text="Central de Tarefas" FontSize="18" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="X" Clicked="OnFecharMenuLateralClicked" BackgroundColor="#f1f5f9" TextColor="#334155" FontAttributes="Bold" WidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/>
                    </Grid>

                    <!-- Card clicavel de Estimativas na cor padrao -->
                    <Border BackgroundColor="#f8fafc" Stroke="#e2e8f0" StrokeThickness="1.5" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardEstimativasMenuTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#e2e8f0" Stroke="Transparent" WidthRequest="38" HeightRequest="38">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="20" TextColor="#334155" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1" Text="Estimativas" FontSize="14" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center"/>

                            <Border x:Name="BadgeCardEstimativas"
                                    Grid.Column="2"
                                    IsVisible="False"
                                    BackgroundColor="#ef4444"
                                    Stroke="Transparent"
                                    MinimumWidthRequest="24"
                                    HeightRequest="24"
                                    Padding="7,0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label x:Name="ContadorEstimativasMenuLabel" Text="0" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="3" Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="20" TextColor="#64748b" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Card clicavel de Cotacoes na cor padrao -->
                    <Border BackgroundColor="#f8fafc" Stroke="#e2e8f0" StrokeThickness="1.5" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardCotacoesMenuTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#e2e8f0" Stroke="Transparent" WidthRequest="38" HeightRequest="38">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="20" TextColor="#334155" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1" Text="Cotações" FontSize="14" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center"/>

                            <Border x:Name="BadgeCardCotacoes"
                                    Grid.Column="2"
                                    IsVisible="False"
                                    BackgroundColor="#ef4444"
                                    Stroke="Transparent"
                                    MinimumWidthRequest="24"
                                    HeightRequest="24"
                                    Padding="7,0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label x:Name="ContadorCotacoesMenuLabel" Text="0" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="3" Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="20" TextColor="#64748b" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Area transparente a direita fecha o menu ao tocar -->
            <BoxView Grid.Column="1" Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFecharMenuLateralTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>

        <!-- Janela sobreposta para escolher o tipo de busca do cliente -->
        <Grid x:Name="OverlayPesquisaCliente" BackgroundColor="#990f172a" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="24" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="330">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="20" Opacity="0.3"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Border BackgroundColor="#dbeafe" Stroke="Transparent" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="28" TextColor="#2563eb" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Opções de Pesquisa" FontAttributes="Bold" FontSize="18" TextColor="#0f172a" HorizontalTextAlignment="Center"/>
                        <Label x:Name="LabelTermoPesquisado" Text="Cliente selecionado" FontSize="13" TextColor="#64748b" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                        <Button Text="Filtrar Apenas Expedição" Clicked="OnOpcaoPesquisaApenasExpedicaoClicked" BackgroundColor="#f1f5f9" TextColor="#1e293b" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" FontSize="13">
                            <Button.ImageSource>
                                <FontImageSource Glyph="&#xe558;" FontFamily="MaterialIcons" Color="#1e293b" Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <Button Text="Ver Todos os Pedidos" Clicked="OnOpcaoPesquisaTodosPedidosClicked" BackgroundColor="#2563eb" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" FontSize="13">
                            <Button.ImageSource>
                                <FontImageSource Glyph="&#xe8ef;" FontFamily="MaterialIcons" Color="White" Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <Button Text="Cancelar" Clicked="OnFecharOverlayPesquisaClicked" BackgroundColor="Transparent" TextColor="#ef4444" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" FontSize="12"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>