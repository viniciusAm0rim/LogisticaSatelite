<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <!-- CONTEÚDO PRINCIPAL -->
        <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16,16,16,85" RowSpacing="12">

            <!-- 1. HEADER (Botão Sincronizar e Perfil) -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Button Grid.Column="0" 
                        x:Name="SincronizarBtn" 
                        Text="Sincronizar" 
                        Clicked="OnSincronizarClicked" 
                        BackgroundColor="#334155" 
                        TextColor="White" 
                        CornerRadius="12" 
                        HeightRequest="44" 
                        FontSize="13" 
                        FontAttributes="Bold" 
                        HorizontalOptions="Start" 
                        Padding="16,0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xe5d5;" FontFamily="MaterialIcons" Color="White" Size="18"/>
                    </Button.ImageSource>
                </Button>

                <Button Grid.Column="1" Clicked="OnPerfilClicked" BackgroundColor="#e2e8f0" TextColor="#334155" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="&#xe8b8;" FontFamily="MaterialIcons" Color="#334155" Size="20"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- 2. BARRA DE PESQUISA (Expedição) -->
            <SearchBar x:Name="PesquisaExpedicaoBar" Grid.Row="1" IsVisible="False" Placeholder="Pesquisar Cliente ou Nº Pedido..." SearchButtonPressed="OnPesquisaExpedicaoPesquisar" TextChanged="OnPesquisaExpedicaoTextChanged" BackgroundColor="White" CancelButtonColor="#ef4444" HeightRequest="42" />

            <!-- 3. ABA RETRÁTIL DE PEDIDOS FINALIZADOS -->
            <Border Grid.Row="2" Stroke="#cbd5e1" StrokeThickness="1" BackgroundColor="White" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePedidosAnterioresTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="HISTÓRICO CONCLUÍDO NESTA ETAPA" FontSize="11" FontAttributes="Bold" TextColor="#64748b" VerticalOptions="Center"/>
                        <Label x:Name="SetaPedidosAnteriores" Text="&#xe5cf;" FontFamily="MaterialIcons" HorizontalOptions="End" TextColor="#64748b" FontSize="18" VerticalOptions="Center"/>
                    </Grid>
                    <StackLayout x:Name="ListaPedidosAnteriores" IsVisible="False">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Opacity="0.95" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="#f1f5f9" Padding="10" Margin="0,0,0,6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPedidoAnteriorItemTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding IdPedido, StringFormat='PEDIDO #{0:D4}'}" FontAttributes="Bold" FontSize="13" TextColor="#334155"/>
                                            <Label Grid.Column="1" Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="#64748b" VerticalOptions="Center"/>
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="3" Margin="0,4,0,0">
                                            <Label Text="{Binding Cliente, StringFormat='Cliente: {0}'}" FontAttributes="Bold" FontSize="11" TextColor="#475569"/>
                                            <BoxView HeightRequest="1" Color="#cbd5e1" Margin="0,2"/>

                                            <Label Text="{Binding SepUser, StringFormat='Separado por: {0}'}" FontSize="10" TextColor="#64748b"/>
                                            <Label Text="{Binding SepFimData, StringFormat='Data Separação: {0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="#64748b"/>

                                            <Label Text="{Binding ConfUser, StringFormat='Conferido por: {0}'}" FontSize="10" TextColor="#64748b"/>
                                            <Label Text="{Binding ConfFimData, StringFormat='Data Conferência: {0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="#64748b"/>

                                            <Label Text="{Binding ExpUser, StringFormat='Expedido por: {0}'}" FontSize="10" TextColor="#64748b"/>
                                            <Label Text="{Binding ExpFimData, StringFormat='Data Expedição: {0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="#64748b"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. ÁREA DE CARREGAMENTO (SKELETON vs LISTA REAL) -->
            <Grid Grid.Row="3">
                <VerticalStackLayout x:Name="SkeletonLoadingView" IsVisible="False" Spacing="12">
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                    <Border BackgroundColor="#e2e8f0" Stroke="Transparent" HeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                    </Border>
                </VerticalStackLayout>

                <CollectionView x:Name="PedidosCollectionView" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="#94a3b8"/>
                            <Label Text="Nenhum pedido nesta fila." FontSize="14" TextColor="#94a3b8" HorizontalOptions="Center" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding IdPedido, StringFormat='Pedido #{0:D4}'}" FontSize="15" FontAttributes="Bold" TextColor="#0f172a" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#f1f5f9" Stroke="Transparent" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Cliente, StringFormat='Cliente: {0}'}" FontSize="12" TextColor="#475569" FontAttributes="Bold"/>
                                        <Label Text="{Binding Modal, StringFormat='Via: {0}'}" FontSize="11" TextColor="#64748b"/>
                                        <Label Text="{Binding SolicitanteEstimativa, StringFormat='Solicitante: {0}'}" FontSize="11" TextColor="#0284c7" IsVisible="{Binding EstimativaSolicitada}"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Row="1" Grid.Column="1" Text="Iniciar" Clicked="OnIniciarAcaoClicked" CommandParameter="{Binding .}" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" HeightRequest="38" WidthRequest="110" CornerRadius="10" FontSize="12" Padding="0" VerticalOptions="Center"/>

                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Enviar Estimativa ao Comercial" Clicked="OnEnviarEstimativaSupervisorClicked" CommandParameter="{Binding .}" BackgroundColor="#f59e0b" TextColor="White" FontAttributes="Bold" HeightRequest="38" CornerRadius="10" FontSize="11" Padding="10,0" Margin="0,4,0,0" IsVisible="{Binding EstimativaSolicitada}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- 5. BARRA DE NAVEGAÇÃO FLUTUANTE INFERIOR -->
        <Border VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,16" Padding="8,6" BackgroundColor="#334155">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="16" Opacity="0.35"/>
            </Border.Shadow>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <!-- ABA SEPARAÇÃO -->
                <Grid x:Name="ContainerAbaSeparacao" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillSeparacao" BackgroundColor="#475569" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconSeparacao" Text="&#xe1a1;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextSeparacao" Text="Separar" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaSeparacaoBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando" BackgroundColor="Transparent"/>
                </Grid>

                <!-- ABA CONFERÊNCIA -->
                <Grid x:Name="ContainerAbaConferencia" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillConferencia" BackgroundColor="Transparent" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconConferencia" Text="&#xe86c;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextConferencia" Text="Conferir" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaConferenciaBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando Conferencia" BackgroundColor="Transparent"/>
                </Grid>

                <!-- ABA EXPEDIÇÃO -->
                <Grid x:Name="ContainerAbaExpedicao" WidthRequest="95" HeightRequest="60">
                    <Border x:Name="PillExpedicao" BackgroundColor="Transparent" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="60" HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                    </Border>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1" InputTransparent="True">
                        <Label x:Name="IconExpedicao" Text="&#xe558;" FontFamily="MaterialIcons" FontSize="22" TextColor="White" HorizontalOptions="Center"/>
                        <Label x:Name="TextExpedicao" Text="Expedir" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button x:Name="AbaExpedicaoBtn" Clicked="OnAbaClicked" CommandParameter="Aguardando Expediçao" BackgroundColor="Transparent"/>
                </Grid>
            </HorizontalStackLayout>
        </Border>

        <!-- POP-UP ESTILIZADO DE OPÇÕES DE PESQUISA DO CLIENTE -->
        <Grid x:Name="OverlayPesquisaCliente" BackgroundColor="#990f172a" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="24" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="330">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="20" Opacity="0.3"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Border BackgroundColor="#dbeafe" Stroke="Transparent" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="28" TextColor="#2563eb" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Opções de Pesquisa" FontAttributes="Bold" FontSize="18" TextColor="#0f172a" HorizontalTextAlignment="Center"/>
                        <Label x:Name="LabelTermoPesquisado" Text="Cliente selecionado" FontSize="13" TextColor="#64748b" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                        <Button Text="Filtrar Apenas Expedição" Clicked="OnOpcaoPesquisaApenasExpedicaoClicked" BackgroundColor="#f1f5f9" TextColor="#1e293b" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" FontSize="13">
                            <Button.ImageSource>
                                <FontImageSource Glyph="&#xe558;" FontFamily="MaterialIcons" Color="#1e293b" Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <Button Text="Ver Todos os Pedidos" Clicked="OnOpcaoPesquisaTodosPedidosClicked" BackgroundColor="#2563eb" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" FontSize="13">
                            <Button.ImageSource>
                                <FontImageSource Glyph="&#xe8ef;" FontFamily="MaterialIcons" Color="White" Size="18"/>
                            </Button.ImageSource>
                        </Button>

                        <Button Text="Cancelar" Clicked="OnFecharOverlayPesquisaClicked" BackgroundColor="Transparent" TextColor="#ef4444" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" FontSize="12"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- OVERLAY DE ESTIMATIVA -->
        <Grid x:Name="OverlayEstimativa" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="24" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Definir Estimativa" FontAttributes="Bold" FontSize="18" TextColor="#0f172a" HorizontalOptions="Center"/>
                    <Label x:Name="LabelPedidoEstimativa" Text="Pedido #0000" FontSize="14" TextColor="#64748b" HorizontalOptions="Center" Margin="0,-5,0,10"/>

                    <Label Text="Data Estimada:" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                    <DatePicker x:Name="EstimativaDatePicker" Format="dd/MM/yyyy" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Label Text="Horário Estimado:" FontSize="13" FontAttributes="Bold" TextColor="#334155" Margin="0,10,0,0"/>
                    <TimePicker x:Name="EstimativaTimePicker" Format="HH:mm" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarEstimativaClicked" BackgroundColor="#ef4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarEstimativaClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>