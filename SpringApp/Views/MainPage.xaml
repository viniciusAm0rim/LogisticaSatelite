<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid RowDefinitions="Auto, Auto, *" Padding="10,20,10,10" RowSpacing="15">

        <!-- 1. HEADER: Sincronizar e Perfil -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center" ColumnSpacing="15">

            <Button Grid.Column="0" 
                    x:Name="SincronizarBtn"
                    Text="Sincronizar" 
                    Clicked="OnSincronizarClicked"
                    BackgroundColor="#004aad" 
                    TextColor="White" 
                    CornerRadius="8"
                    HeightRequest="46"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill" 
                    VerticalOptions="Center"/>

            <!-- Foto de Perfil com gatilho de clique -->
            <Frame Grid.Column="1" WidthRequest="46" HeightRequest="46" CornerRadius="23" 
                   Padding="2" BackgroundColor="#d946ef" HasShadow="False" VerticalOptions="Center">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped" />
                </Frame.GestureRecognizers>

                <Frame CornerRadius="21" Padding="0" HasShadow="False" IsClippedToBounds="True">
                    <Label Text="👤" FontSize="24" BackgroundColor="#e2e8f0" 
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Frame>
            </Frame>
        </Grid>

        <!-- 2. ABAS DINÂMICAS RESPONSIVAS -->
        <Grid Grid.Row="1" x:Name="AbasGrid" ColumnSpacing="4">

            <Button x:Name="AbaSeparacaoBtn" Text="Separar" Clicked="OnAbaClicked" CommandParameter="Aguardando"
                    BackgroundColor="#004aad" TextColor="White" FontAttributes="Bold" FontSize="11" CornerRadius="8" Padding="0"/>

            <Button x:Name="AbaConferenciaBtn" Text="Conferir" Clicked="OnAbaClicked" CommandParameter="Aguardando Conferencia"
                    BackgroundColor="#e2e8f0" TextColor="#475569" FontAttributes="Bold" FontSize="11" CornerRadius="8" Padding="0"/>

            <Button x:Name="AbaAbastecimentoBtn" Text="Abast." Clicked="OnAbaClicked" CommandParameter="Abastecimento"
                    BackgroundColor="#e2e8f0" TextColor="#475569" FontAttributes="Bold" FontSize="11" CornerRadius="8" Padding="0"/>

            <Button x:Name="AbaExpedicaoBtn" Text="Expedir" Clicked="OnAbaClicked" CommandParameter="Aguardando Expediçao"
                    BackgroundColor="#e2e8f0" TextColor="#475569" FontAttributes="Bold" FontSize="11" CornerRadius="8" Padding="0"/>
        </Grid>

        <!-- 3. LISTA DE PEDIDOS -->
        <RefreshView Grid.Row="2" x:Name="AtualizarRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="PedidosCollectionView" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                        <Label Text="📦" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Nenhum pedido pendente." FontSize="14" TextColor="#64748b" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" CornerRadius="8" BorderColor="#cbd5e1" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Numero, StringFormat='Pedido {0}'}" FontAttributes="Bold" FontSize="16" TextColor="#1e293b"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="#0284c7" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Destinatario}" FontSize="13" TextColor="#64748b"/>

                                <Button Grid.Row="1" Grid.Column="1" 
                                        Text="Iniciar" 
                                        Clicked="OnIniciarAcaoClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#16a34a" 
                                        TextColor="White" 
                                        HeightRequest="36" 
                                        CornerRadius="6"
                                        FontSize="12"
                                        Padding="12,0"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>