<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.SeparacaoItensPage"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False" BackgroundColor="#f8fafc">
    <Grid RowDefinitions="*, Auto" RowSpacing="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTelaTapped" />
        </Grid.GestureRecognizers>

        <!-- Campo oculto que mantem o foco do leitor de codigo de barras -->
        <Entry x:Name="LeitorBluetoothEntry"
               Grid.Row="0"
               ZIndex="-1"
               Opacity="0.01"
               HeightRequest="40"
               WidthRequest="200"
               Margin="20,15,0,0"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               Loaded="OnLeitorLoaded"
               Completed="OnCodigoScaneadoCompleted"
               TextChanged="OnLeitorTextChanged"
               Unfocused="OnLeitorUnfocused"/>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,15" Spacing="15">
                <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="SEPARAR ITENS" FontSize="16" FontAttributes="Bold" TextColor="#0f172a" HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Card de notificacao exibido apenas quando ha estimativa pendente nesta separacao -->
                <Border x:Name="CardNotificacaoEstimativaSep"
                        IsVisible="False"
                        Stroke="#f59e0b"
                        StrokeThickness="1.5"
                        BackgroundColor="#fffbeb"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="ESTIMATIVA SOLICITADA" FontSize="11" FontAttributes="Bold" TextColor="#b45309"/>
                            <Label Text="O Comercial pediu previsão de término desta separação." FontSize="12" TextColor="#78350f"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Informar"
                                Clicked="OnAbrirModalEstimativaSepClicked"
                                BackgroundColor="#f59e0b"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="38"
                                WidthRequest="90"
                                CornerRadius="10"
                                Padding="0"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="PEDIDO" FontSize="10" FontAttributes="Bold" TextColor="#94a3b8"/>
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#dcfce7" Stroke="Transparent" Padding="10,4" HorizontalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="ModalLabel" Text="CLIENTE RETIRA" FontSize="11" FontAttributes="Bold" TextColor="#15803d"/>
                        </Border>
                        <Label x:Name="NumeroPedidoLabel" Grid.Row="1" Grid.Column="0" Text="#0001" FontSize="20" FontAttributes="Bold" TextColor="#0f172a"/>
                        <Label x:Name="ClienteLabel" Grid.Row="2" Grid.ColumnSpan="2" Text="NOME DO CLIENTE" FontSize="14" FontAttributes="Bold" TextColor="#475569"/>
                    </Grid>
                </Border>

                <Border Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White" Padding="16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="ITENS A SEPARAR" FontSize="11" FontAttributes="Bold" TextColor="#94a3b8" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Label x:Name="TotalRestanteLabel" Text="0" FontSize="16" FontAttributes="Bold" TextColor="#0f172a"/>
                            <Label Text="de" FontSize="14" TextColor="#64748b" VerticalOptions="Center"/>
                            <Label x:Name="TotalGeralLabel" Text="0" FontSize="14" TextColor="#64748b" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Button Text="DIGITAR CÓDIGO MANUALMENTE" Clicked="OnDigitarCodigoManualClicked" BackgroundColor="#e0f2fe" TextColor="#0369a1" FontAttributes="Bold" FontSize="12" CornerRadius="12" HeightRequest="42"/>

                <CollectionView x:Name="ItensCollectionView" SelectionMode="None" HeightRequest="250">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="16" Stroke="#e2e8f0" StrokeThickness="1" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="0">
                                        <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="14" TextColor="#0f172a"/>
                                        <Label Text="{Binding CodItem, StringFormat='Cód: {0}'}" FontSize="9" TextColor="#64748b"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#fef3c7" Stroke="Transparent" Padding="8,2" HorizontalOptions="Start" Margin="0,4,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding LocalPicking}" FontSize="11" FontAttributes="Bold" TextColor="#d97706"/>
                                    </Border>

                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding ProgressoSeparacaoTexto}" FontSize="11" TextColor="#64748b"/>

                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BackgroundColor="{Binding BotaoSeparacaoCorFundo}" Padding="12,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding BotaoSeparacaoTexto}" TextColor="{Binding BotaoSeparacaoCorTexto}" FontAttributes="Bold" FontSize="12"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="12" BackgroundColor="#f8fafc" Padding="20,10">
            <Button Grid.Column="0" Text="CANCELAR" Clicked="OnCancelarClicked" BackgroundColor="#fee2e2" TextColor="#ef4444" FontAttributes="Bold" HeightRequest="48" CornerRadius="14"/>
            <Button Grid.Column="1" Text="AGUARDAR" Clicked="OnAguardarClicked" BackgroundColor="#fef3c7" TextColor="#b45309" FontAttributes="Bold" HeightRequest="48" CornerRadius="14"/>
        </Grid>

        <!-- Modal sobreposto para o separador informar data e hora de termino -->
        <Grid x:Name="OverlayEstimativaSep" Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border BackgroundColor="White" Padding="22" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Previsão da Separação" FontAttributes="Bold" FontSize="17" TextColor="#0f172a" HorizontalOptions="Center"/>
                    <Label x:Name="LabelResumoItensSep" Text="Itens restantes: 0" FontSize="12" TextColor="#64748b" HorizontalOptions="Center"/>

                    <Label Text="Data Estimada:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <DatePicker x:Name="EstimativaSepDatePicker" Format="dd/MM/yyyy" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Label Text="Horário Estimado:" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                    <TimePicker x:Name="EstimativaSepTimePicker" Format="HH:mm" BackgroundColor="#f8fafc" TextColor="#0f172a"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarModalEstimativaSepClicked" BackgroundColor="#ef4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="Confirmar" Clicked="OnConfirmarModalEstimativaSepClicked" BackgroundColor="#10b981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>