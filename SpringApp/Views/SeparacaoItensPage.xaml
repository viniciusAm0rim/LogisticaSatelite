<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.SeparacaoItensPage"
             Title="Separar Itens">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15" RowSpacing="12">

        <!-- 1. Card Indicador Principal: Total de Itens a Separar -->
        <Frame Grid.Row="0" BackgroundColor="#f0f9ff" BorderColor="#0284c7" Padding="15" CornerRadius="8" HasShadow="False">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="TOTAL DE ITENS A SEPARAR" FontSize="11" TextColor="#0369a1" FontAttributes="Bold"/>
                    <Label x:Name="TotalRestanteLabel" Text="0 de 0" FontSize="26" FontAttributes="Bold" TextColor="#0284c7"/>
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="📦" FontSize="32" VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- 2. Card de Informações: Cliente -->
        <Frame Grid.Row="1" BackgroundColor="#004aad" Padding="15" CornerRadius="8" HasShadow="False">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="NumeroPedidoLabel" Text="Pedido #000" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Label x:Name="ClienteLabel" Text="Cliente: Carregando..." FontSize="14" FontAttributes="Bold" TextColor="#ffffff"/>
            </VerticalStackLayout>
        </Frame>

        <!-- 3. Leitor de Código de Barras -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="CodigoBarraEntry" 
                   Placeholder="Bipe ou digite o código do item..." 
                   Completed="OnBiparCompleted" 
                   ReturnType="Done"/>
            <Button Grid.Column="1" 
                    Text="Bipar" 
                    Clicked="OnBiparClicked" 
                    BackgroundColor="#0284c7" 
                    TextColor="White"/>
        </Grid>

        <!-- 4. Lista de Itens -->
        <CollectionView Grid.Row="3" x:Name="ItensCollectionView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4,0,8" Padding="12" CornerRadius="8" BorderColor="#cbd5e1" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="5">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="15" TextColor="#1e293b"/>
                                <Label Text="{Binding Localizacao, StringFormat='Loc: {0}'}" FontSize="12" TextColor="#d97706" FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="Progresso:" FontSize="13" TextColor="#64748b"/>
                                <Label Text="{Binding BipagensSeparacao}" FontSize="13" FontAttributes="Bold" TextColor="#0284c7"/>
                                <Label Text="de" FontSize="13" TextColor="#64748b"/>
                                <Label Text="{Binding Quantidade}" FontSize="13" FontAttributes="Bold" TextColor="#1e293b"/>
                            </HorizontalStackLayout>

                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="{Binding SeparacaoPendente, StringFormat='Faltam {0}'}" 
                                    Clicked="OnBiparItemDiretoClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#004aad"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="6"
                                    HeightRequest="44"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>