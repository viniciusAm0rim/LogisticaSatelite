<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringApp.Views.LoginPage"
             Title="Login - Logística Satélite">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="📦" FontSize="60" HorizontalOptions="Center"/>
        <Label Text="SATÉLITE" FontSize="24" FontAttributes="Bold" TextColor="#004aad" HorizontalOptions="Center"/>
        <Label Text="Logística Paperless" FontSize="14" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <VerticalStackLayout Spacing="5">
            <Label Text="Matrícula" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
            <Entry x:Name="MatriculaEntry" Placeholder="Ex: 1" Keyboard="Numeric" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Senha" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
            <Entry x:Name="SenhaEntry" Placeholder="••••" IsPassword="True" />
        </VerticalStackLayout>

        <Button Text="Entrar no Sistema" 
                Clicked="OnLoginClicked" 
                BackgroundColor="#004aad" 
                TextColor="White" 
                HeightRequest="48"
                CornerRadius="8"
                Margin="0,10,0,0"/>

    </VerticalStackLayout>
</ContentPage>